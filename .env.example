# Copy to .env (same folder) and fill in. .env is gitignored - never commit it.

# --- Database ---
# Supabase dashboard -> Connect -> "Session pooler" connection string (port 5432).
# Leave empty to use the embedded local Postgres started by `python scripts/local_db.py`.
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- LLM (extraction only; everything else is deterministic) ---
LLM_MODE=external                 # external | onprem (Ollama, nothing leaves the machine)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your-groq-api-key
LLM_MODEL=openai/gpt-oss-120b
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Speech-to-text (same Groq key) ---
STT_MODEL=whisper-large-v3-turbo

# --- Handwriting on scans (optional; needs: pip install -e "services/api[handwriting]") ---
# Runs on this machine. For the GPU build of PyTorch install it first:
#   pip install torch --index-url https://download.pytorch.org/whl/cu124
HANDWRITING_OCR=auto              # auto = only when a GPU is present | on | off
HANDWRITING_MODEL=microsoft/trocr-base-handwritten
HANDWRITING_BELOW=0.90            # clean print scores above this; a page with many regions below it is handwritten

# --- Web origin allowed to call the API ---
WEB_ORIGIN=http://localhost:3000
